  "disposition": "Retain the frozen complete corpus. Future v1 files are provenance-only. Removed IPvFuture cases do not establish a new rejection requirement. Combined URI-template prefix and explode modifiers require correction; the other added cases preserve existing behavior.",
  "groups": [
    {
      "commit": "7741b279ca22de18fb14bfd4d0f4fca011ffca1f",
      "behavior": "idn-email added format cases",
      "schema": {
        "format": "idn-email"
      },
      "format_assertion": true,
      "dialects": [
        "draft2019-09",
        "draft2020-12",
        "draft7"
      ],
      "tests": [
        {
          "description": "a domain label starting with a hyphen is not valid",
          "data": "δοκιμή@-example.com",
          "valid": false
        },
        {
          "description": "a domain label ending with a hyphen is not valid",
          "data": "δοκιμή@example-.com",
          "valid": false
        },
        {
          "description": "a domain starting with a dot is not valid",
          "data": "δοκιμή@.example.com",
          "valid": false
        },
        {
          "description": "a domain ending with a dot is not valid",
          "data": "δοκιμή@example.com.",
          "valid": false
        },
        {
          "description": "two subsequent dots inside the domain are not valid",
          "data": "δοκιμή@example..com",
          "valid": false
        },
        {
          "description": "domain is required",
          "data": "δοκιμή@",
          "valid": false
        }
      ]
    },
    {
