      "commit": "24012d0a2e3f974b53b9393b144ef8244fea9613",
      "behavior": "hostname overall length",
      "schema": {
        "format": "hostname"
      },
      "format_assertion": true,
      "dialects": [
        "draft4",
        "draft6"
      ],
      "tests": [
        {
          "description": "exceeds maximum overall length (256)",
          "data": "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijk.abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijk.abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijk.abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijk.com",
          "valid": false
        }
      ]
    },
    {
      "commit": "5cef06b740b9c7b1ebb309afc24bf460dd397141",
      "behavior": "URI trailing newline",
      "schema": {
        "format": "uri"
      },
      "format_assertion": true,
      "dialects": [
        "draft4",
        "draft6",
        "draft7",
        "draft2019-09",
        "draft2020-12"
      ],
      "tests": [
        {
          "description": "a trailing newline after a valid URI is invalid",
          "data": "http://foo.bar/\n",
          "valid": false
        }
      ]
    },
    {
